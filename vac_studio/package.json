{
  "name": "@vac/studio",
  "version": "1.0.0",
  "description": "Video-as-Code Studio: Deterministic motion graphics editor and code-viewport synchronization engine",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "npx tsx server/studio_launcher.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node --loader tsx server/index.ts",
    "server:dev": "npx tsx server/index.ts",
    "test:net": "npx tsx server/test_tc_net_01.ts",
    "test:m0": "npx tsx tests/run_m0_gate_suite.ts",
    "test:m1": "npx tsx tests/run_m1_gate_suite.ts",
    "test:m1:2": "npx tsx tests/run_m1_2_gate_suite.ts",
    "test:ir": "npx tsx tests/test_ir_bridge_roundtrip.ts",
    "test:skills": "python ../skills/motion-video-director/scripts/audit_skills.py"
  },
  "dependencies": {
    "@remotion/player": "^4.0.544",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.544",
    "tailwind-merge": "^2.5.4",
    "ts-morph": "^28.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
