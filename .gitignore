# ==============================================================================
# Video-as-Code Studio Workspace .gitignore
# ==============================================================================

# Python Virtual Environments & Cache
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/

# Node.js & Remotion Runtime Caches
node_modules/
.remotion/
.cache/
.taste-skill/
.vac/
dist/
build/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cloned External Reference Repositories (Independent Git Repos)
/openmotion/
/cinetic/
/earshot/
/motion2code/
/taste-skill/

# Legacy Experimental Replicas (External Boundary Sanitization)
/space_bunny_replica/
/deconstruct/space_bunny/

# Root-Level Scratch Media, Ad-Hoc Exports & Local Pipelines (Kept off Git)
/*.mp4
/*.mov
/*.wav
/*.jpg
/image*.png
/snap_shot_*.png
/physics_of_gluten_contact_sheet.png
/*.html
/timeline.json
/ref_frames_detail/
/tweet_inspect/
/output/
/pipeline_*/
/run_pipeline.py
/.agents/

# OS & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
.vscode/
.idea/
