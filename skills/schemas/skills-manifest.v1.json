{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./skills-manifest.v1.json",
  "title": "Video-as-Code Skills Manifest v1",
  "type": "object",
  "required": ["version", "routing_policy", "orchestrator_policy", "script_path_convention", "slots"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "routing_policy": { "type": "string" },
    "orchestrator_policy": { "type": "string" },
    "script_path_convention": { "type": "string" },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slot", "owner", "path", "status", "pipeline", "triggers", "excludes", "dependencies", "fallback"],
        "properties": {
          "slot": { "type": "string" },
          "owner": { "type": "string" },
          "path": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "ready-in-repo",
              "partial-in-repo",
              "requires-local-venv",
              "spec-only-external-scripts",
              "orchestrator-policy"
            ]
          },
          "pipeline": { "type": "array", "items": { "type": "string" } },
          "disambiguation": { "type": "string" },
          "triggers": { "type": "array", "items": { "type": "string" } },
          "excludes": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "fallback": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
