{
  "$schema": "./schemas/skills-manifest.v1.json",
  "version": "1.2.0",
  "routing_policy": "skills/ROUTER.md",
  "orchestrator_policy": "skills/motion-video-director/SKILL.md",
  "script_path_convention": "skills/<skill>/scripts/<script>",
  "slots": [
    {
      "slot": "new_launch_or_product_film",
      "owner": "cinetic",
      "path": "skills/cinetic/SKILL.md",
      "status": "ready-in-repo",
      "pipeline": ["earshot", "motion-video-director"],
      "triggers": ["launch film", "product video", "promo clip", "new video from scratch", "做产品宣传片", "从零做视频"],
      "excludes": ["rebuild existing video as SVG", "deconstruct MP4 to blueprint", "landing page UI"],
      "dependencies": ["node >= 22", "ffmpeg >= 6", "python >= 3.11", "earshot 0.4+ (optional for audio kit)"],
      "fallback": "Silent/bed master + skills/motion-video-director/scripts/motion_qa_gate.py"
    },
    {
      "slot": "deconstruct_video_to_remotion_blueprint",
      "owner": "motion-video-deconstruct",
      "path": "skills/motion-video-deconstruct/SKILL.md",
      "status": "partial-in-repo",
      "pipeline": ["motion-video-director"],
      "disambiguation": "Use when the reference video has multi-scene architecture, rich React/Remotion UI, or needs a structured motion_blueprint.json; if it is a flat 2D vector/Lottie loop or single-file HTML animation, use motion2code instead.",
      "triggers": ["deconstruct video", "extract motion blueprint", "参考视频拆解成 Remotion 工程", "逆向分镜"],
      "excludes": ["flat inline SVG loop", "create from scratch without reference"],
      "dependencies": ["ffmpeg", "skills/motion2code/scripts/study_video.py", "skills/motion-video-director/scripts/motion_qa_gate.py"],
      "fallback": "Use skills/motion2code/scripts/study_video.py + manual blueprint JSON"
    },
    {
      "slot": "rebuild_flat_motion_as_svg_gsap",
      "owner": "motion2code",
      "path": "skills/motion2code/SKILL.md",
      "status": "ready-in-repo",
      "pipeline": ["motion-video-director"],
      "disambiguation": "Use when rebuilding a flat 2D motion/GIF/UI clip into a self-contained inline SVG + GSAP HTML loop (<100KB) or ScrollTrigger site.html; for multi-scene Remotion architecture, use motion-video-deconstruct.",
      "triggers": ["convert to SVG/GSAP", "recreate GIF/Lottie", "seamless loop HTML", "界面录屏转交互网页", "矢量无损动效"],
      "excludes": ["Remotion multi-scene film", "3D rendering", "photographic footage"],
      "dependencies": ["python >= 3.9", "ffmpeg", "playwright"],
      "fallback": "N/A"
    },
    {
      "slot": "procedural_sfx_and_audio_qa",
      "owner": "earshot",
      "path": "skills/earshot/SKILL.md",
      "status": "requires-local-venv",
      "pipeline": ["motion-video-director"],
      "disambiguation": "Use when synthesizing procedural CPU SFX/kits (earshot forge/kit) or running quantitative audio critique; if sourcing real CC-licensed recordings/foley, use real-sound.",
      "triggers": ["earshot", "procedural sfx", "audio critique", "listen to soundtrack", "程序化音效", "声学质检"],
      "excludes": ["source real licensed recordings from Freesound/Mixkit"],
      "dependencies": ["local checkout ./earshot and .venv (earshot 0.4+)"],
      "fallback": "ffmpeg ebur128 check via skills/motion-video-director/scripts/motion_qa_gate.py"
    },
    {
      "slot": "real_licensed_soundtrack_sourcing",
      "owner": "real-sound",
      "path": "skills/real-sound/SKILL.md",
      "status": "spec-only-external-scripts",
      "pipeline": ["motion-video-director"],
      "disambiguation": "Use ONLY when sourcing real licensed recordings (Freesound/Mixkit/Openverse) with external mix scripts; for local CPU procedural synthesis, use earshot.",
      "triggers": ["real recordings", "Freesound", "Mixkit", "Openverse", "CC-licensed foley", "真实录音配乐"],
      "excludes": ["pure CPU procedural synthesis (use earshot)"],
      "dependencies": ["external audio sourcing & mixing scripts (not bundled in repo)"],
      "fallback": "Use earshot procedural kit or manual ffmpeg mux + skills/motion-video-director/scripts/motion_qa_gate.py"
    },
    {
      "slot": "frontend_web_and_app_art_direction",
      "owner": "taste-skill",
      "path": "skills/taste-skill/SKILL.md",
      "status": "ready-in-repo",
